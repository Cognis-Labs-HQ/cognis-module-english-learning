[
    {
        "id": "en:word:structure-whether",
        "label": "whether",
        "fields": {
            "part_of_speech": "conjunction",
            "pronunciation": ["/ˈweðə/"],
            "audio": "audio/301909898dd76ee90414022bb143cfdaaddf2a9ac23e2d01db3eb0cdbecc92a4.wav",
            "reference_images": [
                "images/1cec9a92409088e44225e8a253033faed3ceec599c6504ddab877478dd50840c.jpg"
            ],
            "usage_notes": {
                "en": "Whether introduces alternatives or uncertainty. Example: I do not know whether it will rain. The question mark between weather possibilities represents uncertainty, not choosing a path.",
                "de": "Whether leitet Alternativen oder Ungewissheit ein. „I do not know whether it will rain.“ = Ich weiß nicht, ob es regnen wird. Das Fragezeichen zwischen den Wetterlagen steht für Ungewissheit, nicht für eine Wegwahl.",
                "id": "Whether memperkenalkan pilihan atau ketidakpastian. “I do not know whether it will rain.” = Saya tidak tahu apakah akan hujan. Tanda tanya di antara kemungkinan cuaca menunjukkan ketidakpastian, bukan memilih jalan.",
                "ja": "whetherは選択肢や不確かさを示します。「I do not know whether it will rain.」＝雨が降るかどうか分かりません。天気の選択肢の間の疑問符は不確かさを示し、道を選ぶ意味ではありません。"
            }
        },
        "class": "lexical:conjunction",
        "tags": ["conjunction", "sentence-structure", "grammar"],
