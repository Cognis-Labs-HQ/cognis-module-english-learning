    {
        "id": "en:word:structure-instead-of",
        "label": "instead of",
        "fields": {
            "part_of_speech": "preposition",
            "pronunciation": ["/ɪnˈsted əv/"],
            "audio": "audio/b9d9f3951a732b30a00e24f39631b49f0f11a792fe9f6b3aee399e1b05904b75.wav",
            "reference_images": [
                "images/0083fb407d98d8f918069072f7e56c12299ae80450aa61fce2a1704fbd39f8ad.jpg"
            ],
            "usage_notes": {
                "en": "Instead of marks the option being replaced. Example: She chooses sweets instead of an apple. The arrow points from the apple toward sweets: sweets are chosen and the apple is not.",
                "de": "Instead of nennt die ersetzte Möglichkeit. „She chooses sweets instead of an apple.“ = Sie wählt Süßigkeiten statt eines Apfels. Der Pfeil führt vom Apfel zu den Süßigkeiten: Gewählt werden die Süßigkeiten, nicht der Apfel.",
                "id": "Instead of menandai pilihan yang digantikan. “She chooses sweets instead of an apple.” = Dia memilih permen sebagai pengganti apel. Panah menuju permen dari apel: permen dipilih, apel tidak.",
                "ja": "instead ofの後ろには選ばれない方を置きます。「She chooses sweets instead of an apple.」＝彼女はリンゴではなくお菓子を選びます。矢印はリンゴからお菓子に向かい、お菓子が選ばれます。"
            }
        },
        "class": "lexical:preposition",
        "tags": ["preposition", "sentence-structure", "grammar"],
