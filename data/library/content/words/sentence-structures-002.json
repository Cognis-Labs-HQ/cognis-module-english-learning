    {
        "id": "en:word:structure-in-addition",
        "label": "in addition",
        "fields": {
            "part_of_speech": "adverb",
            "pronunciation": ["/ɪn əˈdɪʃən/"],
            "audio": "audio/4eed9e6d57d4fb38708414860c27d633018b066caba4ef3de22b2967ca767454.wav",
            "reference_images": [
                "images/88100a740e64facb217cf560f9cba1d6595d617366bf9e4336d72ab8d34c6bc6.jpg"
            ],
            "usage_notes": {
                "en": "In addition adds another fact. Example: I bought a book. In addition, I bought a notebook. Adding a book to a stack is a visual analogy; the phrase connects information.",
                "de": "In addition fügt eine weitere Tatsache hinzu. „I bought a book. In addition, I bought a notebook.“ = Ich habe ein Buch gekauft. Außerdem habe ich ein Notizbuch gekauft. Das Auflegen eines Buches ist ein Bild für das Hinzufügen von Informationen.",
                "id": "In addition menambahkan fakta lain. “I bought a book. In addition, I bought a notebook.” = Saya membeli buku. Selain itu, saya membeli buku catatan. Menambah buku ke tumpukan adalah perumpamaan visual; frasa ini menghubungkan informasi.",
                "ja": "in additionは別の情報を加えます。「I bought a book. In addition, I bought a notebook.」＝私は本を買いました。さらに、ノートも買いました。積んだ本にもう一冊加える絵は比喩で、表現自体は情報をつなぎます。"
            }
        },
