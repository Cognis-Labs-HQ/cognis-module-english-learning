    {
        "id": "en:word:containers-envelope",
        "label": "envelope",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈenvələʊp/"],
            "usage_notes": {
                "en": "A flat paper container for a letter or document. The partly inserted blank sheet shows its function. Japanese ふうとう keeps both long vowels: ふう・とう. English also has a common pronunciation beginning with /ɒn/.",
                "de": "Eine flache Papierhülle für Briefe oder Dokumente. Das teilweise eingesteckte leere Blatt zeigt die Funktion. In ふうとう bleiben beide langen Vokale erhalten: ふう・とう. Englisch hat auch eine übliche Aussprache mit /ɒn/ am Anfang.",
                "id": "Wadah kertas pipih untuk surat atau dokumen. Kertas kosong yang sebagian masuk menunjukkan fungsinya. ふうとう mempertahankan kedua vokal panjang: ふう・とう. Ada juga pelafalan Inggris yang lazim dengan awal /ɒn/.",
                "ja": "手紙や書類を入れる平たい紙の袋。少し差し込んだ白紙で用途を示します。ふうとうは「ふう・とう」の両方の長い母音を保ちます。英語には語頭を/ɒn/とする一般的な発音もあります。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/1f193ea822d2f45bfe1c3641aacdfe5d1153f1786f73b6614dcbc82a1fa9ed5d.jpg"
            ],
