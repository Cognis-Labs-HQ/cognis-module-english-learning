[
    {
        "id": "en:word:containers-bottle",
        "label": "bottle",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈbɒtl/"],
            "usage_notes": {
                "en": "A container with a narrow neck, often for liquids. The picture shows an empty glass bottle. Japanese びん can also describe some jars; this card illustrates the bottle sense.",
                "de": "Ein Behälter mit engem Hals, oft für Flüssigkeiten. Das Bild zeigt eine leere Glasflasche. Japanisch びん kann auch bestimmte Vorratsgläser bezeichnen; hier ist die Flasche gemeint.",
                "id": "Wadah berleher sempit, sering untuk cairan. Gambar menunjukkan botol kaca kosong. びん juga dapat merujuk pada beberapa jenis stoples; kartu ini menampilkan makna botol.",
                "ja": "細い口を持つ容器で、液体などを入れます。画像は空のガラス瓶です。びんは広口の保存容器にも使えますが、ここでは英語bottleに対応する細口の物を示します。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/013375ac136ca376d5d3029cfc74e6bdcc7ac5d23ddaee1a4aed59ebcc8448f9.jpg"
