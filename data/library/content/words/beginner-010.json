    {
        "id": "en:word:now",
        "label": "now",
        "fields": {
            "part_of_speech": "adverb",
            "pronunciation": ["/naʊ/"],
            "audio": "audio/fa03a6956ae11d3ac821e7c4cdb2792e7eab98c633a5bc1e9ac5ec5a00648da1.wav",
            "reference_images": [
                "images/b7a215212dd8d55f6e597dc55278ad6fd439e30442926d6cf038758d6cd17e95.jpg"
            ],
            "usage_notes": {
                "en": "Now means at the present moment, relative to when someone speaks. Example: I am ready now. A clock is only a time cue; now is not the name of a particular hour.",
                "de": "Now bedeutet jetzt, bezogen auf den Zeitpunkt des Sprechens. „I am ready now.“ = Ich bin jetzt bereit. Die Uhr ist nur ein Zeithinweis; now bezeichnet keine bestimmte Uhrzeit.",
                "id": "Now berarti pada saat ini, relatif terhadap waktu seseorang berbicara. “I am ready now.” = Saya sudah siap sekarang. Jam hanya menjadi petunjuk waktu; now bukan nama suatu jam tertentu.",
                "ja": "nowは、話している時点での「今」です。「I am ready now.」＝今は準備ができています。時計は時間の手がかりで、nowは特定の時刻の名前ではありません。"
            }
        },
        "class": "lexical:adverb",
        "tags": ["adverb", "beginner"],
        "references": [
