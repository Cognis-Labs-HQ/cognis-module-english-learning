    {
        "id": "en:word:colors-red",
        "label": "red",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/red/"],
            "usage_notes": {
                "en": "Here red names the color as a noun. Example: I like red. The same word can describe an object: a red bag.",
                "de": "Hier bezeichnet red die Farbe als Substantiv. Beispiel: I like red. — Ich mag Rot. Dasselbe englische Wort kann auch ein Objekt beschreiben: a red bag.",
                "id": "Di sini red adalah kata benda yang menamai warna. Contoh: I like red. — Saya suka warna merah. Kata yang sama juga dapat menerangkan benda: a red bag.",
                "ja": "ここでのredは色を表す名詞です。例：I like red.（私は赤が好きです。）同じ語で物の色も説明できます：a red bag。"
            },
