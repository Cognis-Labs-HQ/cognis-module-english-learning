    {
        "id": "en:word:places-supermarket",
        "label": "supermarket",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈsuːpəmɑːkɪt/"],
            "usage_notes": {
                "en": "A self-service shop selling groceries and household goods. Plural supermarkets ends in /s/. スーパー abbreviates スーパーマーケット and has two long vowels.",
                "de": "Ein Selbstbedienungsgeschäft für Lebensmittel und Haushaltswaren. Plural supermarkets mit /s/. スーパー ist die Kurzform von スーパーマーケット und enthält zwei lange Vokale.",
                "id": "Toko swalayan yang menjual bahan makanan dan kebutuhan rumah tangga. Bentuk jamak supermarkets berakhir /s/. スーパー adalah singkatan スーパーマーケット dan memiliki dua vokal panjang.",
                "ja": "食品や日用品を売るセルフサービスの店。英語の複数形 supermarkets は /s/ で終わる。スーパーはスーパーマーケットの略で、スーとパーは長音。"
            },
            "part_of_speech": "noun",
