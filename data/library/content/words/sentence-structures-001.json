[
    {
        "id": "en:word:structure-although",
        "label": "although",
        "fields": {
            "part_of_speech": "conjunction",
            "pronunciation": ["/ɔːlˈðəʊ/"],
            "audio": "audio/c46432f9ce81fe96518309f34b04d360fbcd29a145f384847e073e0d91e62c5b.wav",
            "reference_images": [
                "images/5674479f32f97bb27a8a84b76fd3d7ad0bfd03968e2c7163fb33c42812bb71f1.jpg"
            ],
            "usage_notes": {
                "en": "Although introduces a fact that contrasts with the main statement. Example: Although it is raining, she enjoys the picnic. The rain is real in this scene, not merely a possibility.",
                "de": "Although leitet eine Tatsache ein, die der Hauptaussage entgegensteht. „Although it is raining, she enjoys the picnic.“ = Obwohl es regnet, genießt sie das Picknick. Der Regen ist hier tatsächlich da, nicht nur möglich.",
                "id": "Although memperkenalkan fakta yang bertentangan dengan pernyataan utama. “Although it is raining, she enjoys the picnic.” = Meskipun sedang hujan, dia menikmati piknik. Hujannya nyata dalam adegan ini, bukan hanya kemungkinan.",
                "ja": "althoughは主節と対照的な事実を導きます。「Although it is raining, she enjoys the picnic.」＝雨が降っていますが、彼女はピクニックを楽しんでいます。この場面では実際に雨が降っており、単なる可能性ではありません。"
            }
        },
        "class": "lexical:conjunction",
        "tags": ["conjunction", "sentence-structure", "grammar"],
