    {
        "id": "en:word:structure-in-order-to",
        "label": "in order to",
        "fields": {
            "part_of_speech": "adverb",
            "pronunciation": ["/ɪn ˈɔːdə tə/"],
            "audio": "audio/64981e44bd35ca9b6a0af49292c2d5c66e12907c1fdde4a29690bc10120f9a40.wav",
            "reference_images": [
                "images/d0057ca0c8d528f33eb97cd210475d12a9557c4ac0b1df29dcb85a810f1c9b08.jpg"
            ],
            "usage_notes": {
                "en": "In order to + base verb expresses purpose. Example: She studies in order to graduate. The graduation thought bubble represents her goal, not an event already completed.",
                "de": "In order to + Verb in der Grundform drückt einen Zweck aus. „She studies in order to graduate.“ = Sie lernt, um ihren Abschluss zu machen. Die Gedankenblase zeigt ihr Ziel, kein schon abgeschlossenes Ereignis.",
                "id": "In order to + bentuk dasar kata kerja menyatakan tujuan. “She studies in order to graduate.” = Dia belajar agar dapat lulus. Gelembung pikiran wisuda menunjukkan tujuannya, bukan kejadian yang sudah selesai.",
                "ja": "in order toの後ろには動詞の原形を置き、目的を表します。「She studies in order to graduate.」＝彼女は卒業するために勉強します。卒業の吹き出しは目標で、完了した出来事ではありません。"
            }
        },
        "class": "lexical:adverb",
        "tags": ["adverb", "sentence-structure", "grammar"],
