    {
        "id": "en:word:structure-rather-than",
        "label": "rather than",
        "fields": {
            "part_of_speech": "conjunction",
            "pronunciation": ["/ˈrɑːðə ðæn/"],
            "audio": "audio/2293b4c1858191416f97f31beed034240208c891f2f0d51698323da707f620ee.wav",
            "reference_images": [
                "images/6c907b01895eb184bb839590d2fd887381acbcb63eefb0124154dd8b9ff7353f.jpg"
            ],
            "usage_notes": {
                "en": "Rather than contrasts a chosen option with an alternative. Example: I walk rather than drive. The shoes are selected; the car keys are rejected.",
                "de": "Rather than stellt die gewählte Möglichkeit einer Alternative gegenüber. „I walk rather than drive.“ = Ich gehe zu Fuß, statt zu fahren. Die Schuhe werden gewählt, die Autoschlüssel abgelehnt.",
                "id": "Rather than membandingkan pilihan yang diambil dengan alternatifnya. “I walk rather than drive.” = Saya berjalan kaki daripada mengemudi. Sepatu dipilih; kunci mobil tidak.",
                "ja": "rather thanは選ぶ方と選ばない方を対比します。「I walk rather than drive.」＝私は車で行くよりも歩きます。靴が選ばれ、車の鍵は選ばれていません。"
            }
        },
        "class": "lexical:conjunction",
        "tags": ["conjunction", "sentence-structure", "grammar"],
