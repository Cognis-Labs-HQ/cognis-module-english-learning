    {
        "id": "en:word:structure-meanwhile",
        "label": "meanwhile",
        "fields": {
            "part_of_speech": "adverb",
            "pronunciation": ["/ˈmiːnwaɪl/"],
            "audio": "audio/9afb55a294e74d6963d2e6b60473ee1779e93da45f00a09ce8ab2c303c9c41ea.wav",
            "reference_images": [
                "images/83775cad72592d7cf9bc8f12907be2a671bf3412551099a2fff8e65372b58a12.jpg"
            ],
            "usage_notes": {
                "en": "Meanwhile connects events happening during the same period. Example: She is cooking. Meanwhile, he is reading. The shared clock represents overlapping time, not one action following the other.",
                "de": "Meanwhile verbindet Vorgänge im selben Zeitraum. „She is cooking. Meanwhile, he is reading.“ = Sie kocht. Währenddessen liest er. Die gemeinsame Uhr zeigt zeitliche Überschneidung, keine Abfolge.",
                "id": "Meanwhile menghubungkan kejadian dalam waktu yang sama. “She is cooking. Meanwhile, he is reading.” = Dia sedang memasak. Sementara itu, laki-laki itu sedang membaca. Jam bersama menunjukkan waktu yang tumpang tindih, bukan urutan tindakan.",
                "ja": "meanwhileは同じ時間帯の出来事をつなぎます。「She is cooking. Meanwhile, he is reading.」＝彼女は料理をしています。その間、彼は読書をしています。共通の時計は時間の重なりを示し、順番ではありません。"
            }
        },
        "class": "lexical:adverb",
        "tags": ["adverb", "sentence-structure", "grammar"],
