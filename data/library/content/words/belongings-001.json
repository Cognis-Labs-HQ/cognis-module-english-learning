    {
        "id": "en:word:belongings-glasses",
        "label": "glasses",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈɡlɑːsɪz/"],
            "usage_notes": {
                "en": "Eyewear with two lenses. English glasses takes plural agreement: My glasses are here. One item is a pair of glasses, not a glass. Japanese めがね does not itself mark singular or plural.",
                "de": "Sehhilfe mit zwei Gläsern. Englisch glasses verlangt den Plural: My glasses are here. Ein Gegenstand heißt a pair of glasses, nicht a glass. Japanisch めがね kennzeichnet allein keinen Numerus.",
                "id": "Alat bantu penglihatan dengan dua lensa. Kata Inggris glasses memakai kesesuaian jamak: My glasses are here. Satu benda disebut a pair of glasses, bukan a glass. めがね tidak menandai tunggal atau jamak.",
                "ja": "二つのレンズを備えた視力補助具。英語のglassesは複数扱いです：My glasses are here. 一つはa pair of glassesといい、a glassではありません。日本語の「めがね」自体は単複を表しません。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/f3a50b18baa301306269a2bb4d5ffc8ee3daa16978dfb0b566d1b184dd483c2d.jpg"
