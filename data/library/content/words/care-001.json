[
    {
        "id": "en:word:care-soap",
        "label": "soap",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/səʊp/"],
            "usage_notes": {
                "en": "Soap for washing the body. Usually uncountable in everyday requests; a bar of soap counts one solid piece. Soaps can refer to varieties. せっけん contains small っ, which doubles the following consonant.",
                "de": "Seife zum Waschen des Körpers. Im Englischen in alltäglichen Bitten meist nicht zählbar; a bar of soap zählt ein Stück. Soaps kann Sorten bezeichnen. Das kleine っ in せっけん verdoppelt den folgenden Konsonanten.",
                "id": "Sabun untuk membersihkan tubuh. Dalam permintaan sehari-hari, soap biasanya tak terhitung; a bar of soap menyatakan satu batang. Soaps dapat merujuk pada jenis. っ kecil dalam せっけん menggandakan konsonan berikutnya.",
                "ja": "体を洗う石けん。英語では日常的な依頼で通常は不可算名詞。固形の一個は a bar of soap、種類には soaps も使う。せっけんの小さいっは促音。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/481a7aa164603efdfe2a5765a29f2cfba0c6bf765577907887e72fbc0f097fe1.jpg"
