    {
        "id": "en:word:care-toothbrush",
        "label": "toothbrush",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈtuːθbrʌʃ/"],
            "usage_notes": {
                "en": "A brush for cleaning teeth. Countable; plural toothbrushes adds a syllable /ɪz/. ハブラシ is a kana spelling of 歯ブラシ, read はぶらし.",
                "de": "Eine Bürste zum Reinigen der Zähne. Zählbar; der Plural toothbrushes fügt die Silbe /ɪz/ hinzu. ハブラシ ist eine Kana-Schreibweise von 歯ブラシ, gelesen はぶらし.",
                "id": "Sikat untuk membersihkan gigi. Dapat dihitung; bentuk jamak toothbrushes menambah suku kata /ɪz/. ハブラシ adalah ejaan kana untuk 歯ブラシ, dibaca はぶらし.",
                "ja": "歯を磨くためのブラシ。英語では可算名詞で、複数形 toothbrushes では /ɪz/ の一音節を加える。ハブラシは歯ブラシの仮名表記で、読みははぶらし。"
            },
            "part_of_speech": "noun",
