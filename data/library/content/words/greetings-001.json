[
    {
        "id": "en:word:greetings-morning",
        "label": "Good morning",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["/ˌɡʊd ˈmɔːnɪŋ/"],
            "usage_notes": {
                "en": "Morning greeting. Japanese おはようございます is polite; おはよう is the shorter casual form. Example: Good morning! / おはようございます。 The sunrise scene suggests a common setting, not a mandatory gesture.",
                "de": "Morgengruß. おはようございます ist höflich, おはよう die kürzere vertraute Form. Beispiel: Guten Morgen! Die Szene bei Sonnenaufgang zeigt einen typischen Kontext, keine vorgeschriebene Geste.",
                "id": "Salam pagi. おはようございます bersifat sopan; おはよう adalah bentuk singkat yang akrab. Contoh: Selamat pagi! Adegan matahari terbit menunjukkan konteks, bukan gestur wajib.",
                "ja": "朝の挨拶。おはようございますは丁寧で、おはようは親しい相手への短い形。例：おはようございます。朝日の場面は一般的な文脈で、決まったしぐさを示すものではありません。"
            },
            "part_of_speech": "interjection",
            "reference_images": [
