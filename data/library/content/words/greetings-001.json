    {
        "id": "en:word:greetings-later",
        "label": "See you",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["/ˈsiː juː/"],
            "usage_notes": {
                "en": "Casual parting phrase for friends or familiar peers. Japanese またね is not a general formal farewell to a customer or superior. Example: See you tomorrow! / またね。 An exact next meeting need not be arranged.",
                "de": "Vertrauter Abschiedsgruß unter Freunden oder Bekannten. またね ist kein allgemeiner förmlicher Abschied gegenüber Kunden oder Vorgesetzten. Beispiel: Bis morgen! Ein nächstes Treffen muss noch nicht vereinbart sein.",
                "id": "Ucapan berpisah akrab untuk teman. またね bukan salam perpisahan formal umum kepada pelanggan atau atasan. Contoh: Sampai jumpa besok! Pertemuan berikutnya tidak harus sudah dijadwalkan.",
                "ja": "友人など親しい相手との別れの挨拶。客や上司への一般的な改まった挨拶ではありません。例：またね。次の約束が決まっていなくても使えます。"
            },
            "part_of_speech": "interjection",
            "reference_images": [
                "images/c8e2279bbbe6f5e0f736942977f6dc2435b111ddccbb915adbdad8c92761a626.jpg"
            ],
            "audio": "audio/11d0aa4993adbf04935c800d21f7895d31be66a7182ed24321ef86a7fadcd4e3.wav"
        },
