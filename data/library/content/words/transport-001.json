    {
        "id": "en:word:transport-boat",
        "label": "boat",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/bəʊt/"],
            "usage_notes": {
                "en": "A small vessel travelling on water, illustrated as a rowboat. ボート fits this small-boat sense; it does not name every large ship. The long vowel in ボー must be preserved. Plural boats ends in /s/.",
                "de": "Ein kleines Wasserfahrzeug, hier als Ruderboot dargestellt. ボート passt zu diesem Sinn und bezeichnet nicht jedes große Schiff. Der lange Vokal in ボー bleibt erhalten. Boats endet auf /s/.",
                "id": "Kendaraan air kecil, digambarkan sebagai perahu dayung. ボート sesuai dengan makna perahu kecil ini, bukan semua kapal besar. Vokal panjang ボー harus dipertahankan. Boats berakhir /s/.",
                "ja": "水上を進む小型の乗り物で、絵は手こぎボート。ボートはこの小型船の意味に合い、あらゆる大型船を指すわけではない。ボーは長音。英語の複数形 boats は /s/ で終わる。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/a9fe4da1953f03289a752eeb21e8cd9407aabd0f203c8fd075758523111d28bd.jpg"
            ],
