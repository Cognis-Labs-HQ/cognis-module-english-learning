[
    {
        "id": "en:word:transport-airplane",
        "label": "airplane",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["/ˈeəpleɪn/"],
            "usage_notes": {
                "en": "A powered aircraft with fixed wings. Airplane is especially North American; plane is common in both major varieties, and aeroplane is also British. The displayed IPA is non-rhotic. ひこうき has a long vowel in こう.",
                "de": "Ein motorisiertes Luftfahrzeug mit festen Tragflächen. Airplane ist besonders nordamerikanisch; plane ist allgemein üblich, aeroplane auch britisch. Die angegebene IPA ist nicht-rhotisch. ひこうき enthält einen langen Vokal in こう.",
                "id": "Pesawat bermesin dengan sayap tetap. Airplane terutama dipakai di Amerika Utara; plane lazim dalam kedua ragam utama, dan aeroplane juga dipakai di Inggris. IPA yang ditampilkan non-rotik. ひこうき memiliki vokal panjang pada こう.",
                "ja": "固定翼を持つ動力付きの航空機。airplane は特に北米で使い、plane は英米共通、aeroplane はイギリスでも使う。表示IPAは非R音性の発音。ひこうきのこうは長音。"
            },
            "part_of_speech": "noun",
            "reference_images": [
                "images/701064ecc2d4d28004a0daf059d57f0d4fb69d87fce6c6931aa0684e538e6730.jpg"
